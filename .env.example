ANTHROPIC_API_KEY=
RENEWAL_MODEL=claude-sonnet-4-6

# Path to the seed account file. In production, plug in your real account
# loader that pulls from HubSpot + portal usage tables.
RENEWAL_ACCOUNTS=accounts/sample.yaml

# Pre-trained logistic-regression coefficients (JSON). Defaults to the
# bundled coeffs derived from synthetic data.
RENEWAL_MODEL_COEFFS=model/coefficients.json
